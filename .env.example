# Site URL (required for Decap OAuth + order emails in production)
NEXT_PUBLIC_SITE_URL=https://subzeecreations.vercel.app

# Order emails via Resend (https://resend.com)
# Sign up, create an API key, and verify a sending domain for production.
# Until a domain is verified, use onboarding@resend.dev as ORDER_FROM_EMAIL
# (Resend only delivers to your account email in that case).
RESEND_API_KEY=
ORDER_TO_EMAIL=subzeecreations@proton.me
ORDER_FROM_EMAIL=onboarding@resend.dev

# Decap CMS GitHub OAuth (for editing at /admin in production)
# Create a GitHub OAuth App: https://github.com/settings/applications/new
# Homepage URL: https://subzeecreations.vercel.app
# Callback URL: https://subzeecreations.vercel.app/api/decap-auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
